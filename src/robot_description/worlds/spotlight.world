<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="custom_world_with_spotlight">
    
    <!-- ÉCLAIRAGE AMBIANT AMÉLIORÉ -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>        <!-- Beaucoup plus d'ambiant pour les reflets -->
      <background>0.7 0.7 0.7 1.0</background>   <!-- Fond plus clair -->
      <shadows>1</shadows>                       <!-- Ombres activées -->
    </scene>

    <!-- Include a ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- SOLEIL AMÉLIORÉ pour reflets -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.5 1.5 1.5 1</diffuse>           <!-- Plus intense -->
      <specular>2.0 2.0 2.0 1</specular>         <!-- SPECULAR TRÈS ÉLEVÉ -->
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- SPOTLIGHT 1 AMÉLIORÉ -->
    <light name="spot_light1" type="spot">
      <pose>1 0 0.55 0 1.45 0</pose>
      <diffuse>1.2 1.2 1.2 1.0</diffuse>         <!-- Plus intense -->
      <specular>1.5 1.5 1.5 1.0</specular>       <!-- SPECULAR TRÈS ÉLEVÉ au lieu de 0.1 -->
      <attenuation>
        <range>15.0</range>                      <!-- Portée augmentée -->
        <constant>0.1</constant>                 <!-- Atténuation réduite -->
        <linear>0.005</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.4</inner_angle>           <!-- Angle réduit pour concentrer -->
        <outer_angle>0.8</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- SPOTLIGHT 2 AMÉLIORÉ -->
    <light name="spot_light2" type="spot">
      <pose>-0.7 0.7 0.85 0 1.1854 2.35</pose>
      <diffuse>1.2 1.2 1.2 1.0</diffuse>         <!-- Plus intense -->
      <specular>1.5 1.5 1.5 1.0</specular>       <!-- SPECULAR TRÈS ÉLEVÉ -->
      <attenuation>
        <range>15.0</range>
        <constant>0.1</constant>
        <linear>0.005</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.4</inner_angle>
        <outer_angle>0.8</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- SPOTLIGHT 3 SUPPLÉMENTAIRE - Pour encore plus de reflets -->
    <light name="spot_light3" type="spot">
      <pose>0 1.5 1.2 0 0.8 -1.57</pose>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
      <specular>1.2 1.2 1.2 1.0</specular>       <!-- Fort spéculaire -->
      <attenuation>
        <range>12.0</range>
        <constant>0.15</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.6</inner_angle>
        <outer_angle>1.0</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>false</cast_shadows>          <!-- Pas d'ombres pour cette lumière -->
    </light>

    <!-- LUMIÈRE POINT AU-DESSUS pour éclairage général -->
    <light name='point_light_top' type='point'>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>1.0 1.0 1.0 1</specular>          <!-- Spéculaire élevé -->
      <attenuation>
        <range>8</range>
        <constant>0.2</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- LUMIÈRE POINT LATÉRALE pour reflets d'appoint -->
    <light name='side_light' type='point'>
      <pose>2 -1 1.5 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>6</range>
        <constant>0.3</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Physique standard -->
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Plugin Gazebo ROS -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

  </world>
</sdf>